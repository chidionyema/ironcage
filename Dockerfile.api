FROM debian:bookworm-slim

RUN apt-get update && apt-get install -y libssl3 ca-certificates && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# Binary pre-built and copied from host during build
COPY target/release/ironcage-api /app/ironcage-api

EXPOSE 3001

USER 65532:65532
ENTRYPOINT ["/app/ironcage-api"]
