FROM debian:bookworm-slim

RUN apt-get update && apt-get install -y sqlite3 libssl3 ca-certificates && rm -rf /var/lib/apt/lists/* && \
    mkdir -p /app /data && chmod 700 /data

WORKDIR /app

# Binary pre-built and copied from host during build
COPY target/release/ironcage-kernel /app/ironcage-kernel

EXPOSE 3000

USER 65532:65532
ENTRYPOINT ["/app/ironcage-kernel"]
